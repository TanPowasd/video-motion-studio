{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "vite.agent.config.ts",
    "vitest.config.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "skills/**/*.ts",
    "skills/**/*.tsx"
  ]
}
