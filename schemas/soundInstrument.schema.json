{
  "$ref": "#/definitions/soundInstrument",
  "definitions": {
    "soundInstrument": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "synth"
            },
            "wave": {
              "type": "string",
              "enum": [
                "sine",
                "triangle",
                "saw",
                "square",
                "noise"
              ],
              "default": "sine"
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0.3
            },
            "attack": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0.008
            },
            "decay": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0.15
            },
            "sustain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.6
            },
            "release": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0.2
            },
            "fmRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 0
            },
            "fmIndex": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 0
            },
            "detune": {
              "type": "number",
              "minimum": -100,
              "maximum": 100,
              "default": 0
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "drum"
            },
            "voice": {
              "type": "string",
              "enum": [
                "kick",
                "snare",
                "hat",
                "tom",
                "clap"
              ]
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0.5
            },
            "release": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 3,
              "default": 0.3
            }
          },
          "required": [
            "type",
            "voice"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sample"
            },
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "sourceIn": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "sourceDuration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1800
            },
            "rootNote": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 127
                },
                {
                  "type": "string",
                  "pattern": "^[A-Ga-g](?:#|b)?-?\\d{1,2}$"
                }
              ],
              "default": 60
            },
            "loop": {
              "type": "boolean",
              "default": false
            },
            "attack": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0.005
            },
            "release": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0.05
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            }
          },
          "required": [
            "type",
            "assetId",
            "sourceDuration"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
