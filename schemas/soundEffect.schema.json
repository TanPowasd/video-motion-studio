{
  "$ref": "#/definitions/soundEffect",
  "definitions": {
    "soundEffect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gain"
            },
            "db": {
              "type": "number",
              "minimum": -80,
              "maximum": 24
            }
          },
          "required": [
            "type",
            "db"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "filter"
            },
            "mode": {
              "type": "string",
              "enum": [
                "lowpass",
                "highpass",
                "peaking",
                "lowshelf",
                "highshelf"
              ]
            },
            "frequency": {
              "type": "number",
              "minimum": 10,
              "maximum": 22000
            },
            "q": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 20,
              "default": 0.707
            },
            "db": {
              "type": "number",
              "minimum": -24,
              "maximum": 24,
              "default": 0
            }
          },
          "required": [
            "type",
            "mode",
            "frequency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "distortion"
            },
            "drive": {
              "type": "number",
              "minimum": 1,
              "maximum": 30,
              "default": 3
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "delay"
            },
            "seconds": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 3,
              "default": 0.25
            },
            "rightSeconds": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 3
            },
            "feedback": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9,
              "default": 0.3
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.25
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "chorus"
            },
            "rate": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 10,
              "default": 0.8
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.015,
              "default": 0.003
            },
            "delay": {
              "type": "number",
              "minimum": 0.016,
              "maximum": 0.05,
              "default": 0.02
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.3
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reverb"
            },
            "seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 8,
              "default": 1.5
            },
            "damping": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.95,
              "default": 0.4
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.2
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "compressor"
            },
            "thresholdDb": {
              "type": "number",
              "minimum": -60,
              "maximum": 0,
              "default": -18
            },
            "ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 30,
              "default": 4
            },
            "kneeDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 24,
              "default": 6
            },
            "attack": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 0.5,
              "default": 0.01
            },
            "release": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 3,
              "default": 0.15
            },
            "makeupDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 24,
              "default": 0
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "limiter"
            },
            "ceilingDb": {
              "type": "number",
              "minimum": -24,
              "maximum": 0,
              "default": -1
            },
            "release": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 3,
              "default": 0.1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
