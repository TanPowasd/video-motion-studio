{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@vmotion/sdk": ["src/sdk/index.ts"],
      "@vmotion/sdk/jsx-runtime": ["src/sdk/index.ts"],
      "@vmotion/sdk/jsx-dev-runtime": ["src/sdk/index.ts"]
    }
  }
}
